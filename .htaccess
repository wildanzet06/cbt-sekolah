RewriteEngine On

# =====================================================================
# Pengerasan keamanan
# =====================================================================

# Jangan tampilkan daftar isi folder
Options -Indexes

# Blokir metadata repository & file dotfile (.git, .env, .idea, dst.)
RewriteRule (^|/)\.(git|svn|hg|env|htaccess|htpasswd|idea|vscode)(/|$) - [F,L]

# Blokir file dokumentasi/konfigurasi yang tidak perlu diakses lewat web
RewriteRule ^(composer\.(json|lock)|options\.json|package(-lock)?\.json|README[^/]*|LICEN[CS]E[^/]*|contributing\.md|plus\.md|_Sidebar\.md)$ - [F,L]

# Blokir folder dokumentasi (berisi skema & catatan internal)
RewriteRule ^docs/ - [F,L]

# Aplikasi tetap jalan seperti biasa
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]

# =====================================================================
# Blokir ekstensi berbahaya (berlaku juga untuk subfolder)
# =====================================================================
<FilesMatch "(^TERPASANG$|\.(sql|md|log|lock|ini|bak|old|orig|sh|bat|ps1|dist)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# =====================================================================
# Header keamanan dasar
# =====================================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://oss.maxcdn.com https://app.midtrans.com https://app.sandbox.midtrans.com https://static.cloudflareinsights.com; font-src 'self' data:; connect-src 'self' https://app.midtrans.com https://app.sandbox.midtrans.com https://api.midtrans.com https://api.sandbox.midtrans.com https://cloudflareinsights.com https://static.cloudflareinsights.com; media-src 'self' blob:; frame-src 'self' blob: data: https://app.midtrans.com https://app.sandbox.midtrans.com; object-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # SameSite sudah ditetapkan CodeIgniter: sesi = Lax, token CSRF = Strict.
    # Jangan ditambahkan lagi lewat Header edit — atribut SameSite yang dobel
    # bisa ditolak browser (terutama Edge) sehingga sesi login hilang.
</IfModule>
# B-5 pilot: halaman login tidak memakai script inline; CSP lebih ketat.
<If "%{REQUEST_URI} =~ m#/auth/?$#">
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; frame-src 'self' blob: data:; object-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'"
</If>
