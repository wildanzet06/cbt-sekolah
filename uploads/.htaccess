# Folder upload: jangan tampilkan daftar file, dan jangan pernah
# mengeksekusi skrip yang diunggah.
Options -Indexes

<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|rb|cgi|sh|asp|aspx|jsp|jspx|htm|html|svg|xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>