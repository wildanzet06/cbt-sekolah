# ===== Tambahkan di BAGIAN BAWAH file .gitignore yang sudah ada =====

# Pengaturan editor
.idea/
*.iml
.vscode/

# Kunci rahasia (yang ikut hanya midtrans.php.example)
application/config/midtrans.php

# Cadangan database
backups/

# Berkas unggahan pengguna (foto siswa, bukti transfer, dll.)
# Folder dan index.html pelindung tetap ikut
uploads/**
!uploads/**/
!uploads/**/index.html

# Log dan cache
application/logs/*
!application/logs/index.html
application/cache/*
!application/cache/index.html

# ===== Template import (bagian dari aplikasi, ikut repository) =====
# Folder uploads tetap dipakai untuk berkas unggahan pengguna, tetapi folder
# template import dikecualikan agar ikut ter-commit dan tidak hilang saat
# pindah server. Hanya jenis file template di bawah ini yang diikutkan.
uploads/*
!uploads/import/
uploads/import/*
!uploads/import/format/
uploads/import/format/*
!uploads/import/format/*.xlsx
!uploads/import/format/*.docx
!uploads/import/format/*.pdf